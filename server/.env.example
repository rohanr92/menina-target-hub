# Copy to server/.env for local development. On Railway, set these as service Variables.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/menina_target_hub
# Long random string. Encrypts every API key/token stored in the database. Never change it after setup
# (stored credentials could no longer be decrypted). Generate: openssl rand -hex 32
ENCRYPTION_KEY=
# Team login password for the app
APP_PASSWORD=
PORT=8080
# Public URL of the app (used for the Target OAuth callback and Shopify webhook URLs)
PUBLIC_URL=http://localhost:8080
